        (item_pickable dish_1)
        (item_accessible dish_2)
        (item_pickable dish_2)
        (item_accessible dish_3)
        (item_pickable dish_3)
        (item_accessible eggs)
        (item_pickable eggs)
        (item_accessible kitchen_lightswitch)
        (item_accessible bathroom_lightswitch)
