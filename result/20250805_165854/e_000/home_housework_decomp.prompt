        (is_lightswitch bathroom_lightswitch)
        (is_lightswitch bedroom_lightswitch)
        (is_lightswitch livingroom_lightswitch)
        (is_egg_container egg_container)

        (not (toasted bread))
        (not (boiled kettle))
        (not (cooked cup_ramen))
        (not (heated food))
        (not (clean clothes))
        (not (charged phone))
        (not (clean desk))
